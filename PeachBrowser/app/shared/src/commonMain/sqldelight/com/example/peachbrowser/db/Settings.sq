CREATE TABLE SettingsEntity (
    key TEXT NOT NULL PRIMARY KEY,
    setting_value TEXT NOT NULL
);

getSetting:
SELECT setting_value FROM SettingsEntity WHERE key = ?;

getAllSettings:
SELECT * FROM SettingsEntity;

setSetting:
INSERT OR REPLACE INTO SettingsEntity(key, setting_value)
VALUES (?, ?);

deleteSetting:
DELETE FROM SettingsEntity WHERE key = ?;
